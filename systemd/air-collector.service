[Unit]
Description=SPS30 Air Quality Collector
Documentation=https://github.com/YOUR_USERNAME/rpi-sps30-air-quality
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/rpi-sps30-air-quality
EnvironmentFile=/home/pi/rpi-sps30-air-quality/.env
ExecStart=/home/pi/rpi-sps30-air-quality/.venv/bin/python -m collector.scheduler
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

