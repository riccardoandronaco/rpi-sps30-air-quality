{
  "include": ["collector", "api", "alerts"],
  "exclude": ["**/__pycache__", ".venv"],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  "reportMissingModuleSource": "none",
  "reportMissingImports": "warning",
  "reportAttributeAccessIssue": "warning",
  "stubPath": "stubs",
  "useLibraryCodeForTypes": true
}

