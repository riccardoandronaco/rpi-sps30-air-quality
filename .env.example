# SPS30 Air Quality Monitor – Environment Configuration
# Copy to .env and fill in your values

# ── Collection settings ──────────────────────────────────────────────────────
COLLECTION_INTERVAL=60      # seconds between readings
SENSOR_WARMUP=5             # seconds to warm up SPS30 fan before reading

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use default: <project_root>/data/air_quality.db
DB_PATH=

# ── Alert thresholds (WHO guidelines) ────────────────────────────────────────
PM25_ALERT_THRESHOLD=25.0   # µg/m³
PM10_ALERT_THRESHOLD=50.0   # µg/m³

# ── Telegram bot (optional) ──────────────────────────────────────────────────
# Leave empty to disable alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

