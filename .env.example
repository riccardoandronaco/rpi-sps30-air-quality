# SPS30 Air Quality Monitor – Environment Configuration
# Note: systemd EnvironmentFile does NOT support inline comments after values!
# Place comments on their own lines.

# Seconds between readings (default: 60)
COLLECTION_INTERVAL=60

# Seconds to warm up SPS30 fan before reading (default: 5)
SENSOR_WARMUP=5

# Database path (leave empty to use default: data/air_quality.db)
DB_PATH=

# WHO alert thresholds (in µg/m³)
PM25_ALERT_THRESHOLD=25.0
PM10_ALERT_THRESHOLD=50.0

# Telegram bot (optional: leave empty to disable alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Location override for outdoor air quality (optional)
# By default, location and coordinates are auto-detected via public IP.
# If you prefer to manually override coordinates:
LATITUDE=
LONGITUDE=
LOCATION_NAME=

